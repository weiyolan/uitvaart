NEXT_PUBLIC_SANITY_PROJECT_ID="daxfkv44"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-06-01"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Viewer-role token for runtime reads (defineLive / draft mode).
SANITY_API_READ_TOKEN=""

# Editor/write token — used by `npm run seed` only. Never set this on Netlify.
SANITY_API_WRITE_TOKEN=""

# Contact form delivery (Resend). Sends two branded emails per submission:
# a notification to Milo and a confirmation to the visitor.
# RESEND_API_KEY: from resend.com. CONTACT_TO_EMAIL: where Milo receives requests.
# CONTACT_FROM_EMAIL: MUST be a verified domain sender — the visitor confirmation
# only reaches real inboxes from a verified domain (onboarding@resend.dev is
# test-only and won't deliver to arbitrary addresses).
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
CONTACT_FROM_EMAIL="Milo Weiler <onboarding@resend.dev>"
